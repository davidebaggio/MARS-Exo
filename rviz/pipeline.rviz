Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /HeadDepthImage1
        - /ExoDepthImage1
        - /HeadDebugCloud1
        - /ExoDebugCloud1
        - /VGGT Combined Cloud1
        - /GT Global Map (world)1
        - /GT Exoskeleton Odometry1
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: HeadDepthImage
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /head/filtered/depth_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: ExoDepthImage
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /exo/filtered/depth_raw
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: false
      Name: HeadDebugCloud
      Size (Pixels): 3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /head/debug_pcl
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: false
      Name: ExoDebugCloud
      Size (Pixels): 3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /exo/debug_pcl
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: true
      Name: VGGT Combined Cloud
      Size (Pixels): 3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vggt/combined_pointcloud
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: true
      Name: ORB-SLAM3 Estimated Map
      Size (Pixels): 3
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /orbslam/cloud_map
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/PointCloud2
      Color: 85; 255; 127
      Color Transformer: FlatColor
      Enabled: true
      Name: GT Global Map (world)
      Size (Pixels): 2
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/global_map
      Value: true
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 170; 0
      Color Transformer: FlatColor
      Enabled: false
      Name: GT Visible Cloud (world)
      Size (Pixels): 2
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ground_truth/visible_cloud
      Value: false
    - Alpha: 0.35
      Class: rviz_default_plugins/PointCloud2
      Color: 85; 170; 255
      Color Transformer: FlatColor
      Enabled: false
      Name: GT Visible Map (world)
      Size (Pixels): 2
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/visible_map
      Value: false
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: GT Exoskeleton Odometry
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /exoskeleton/odom
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Backend: ogre
      Enabled: false
      Name: Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Interval: 1
      Use Timestamp: false
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: viz_ground
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Name: Current View
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785398
Window Geometry:
  Displays:
    Height: 800
    Width: 400
    X: 0
    Y: 0
  Views:
    Height: 400
    Width: 400
    X: 0
    Y: 400
